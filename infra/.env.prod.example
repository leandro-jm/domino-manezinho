POSTGRES_PASSWORD=troca-isso
JWT_SECRET=um-segredo-bem-comprido
PUBLIC_URL=https://domino.exemplo.com.br
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@dominomanezinho.app
# Saltos de proxy confiáveis (1 = o proxy HTTPS na frente) ou lista de IPs/CIDRs.
TRUST_PROXY=1
# Interface onde a porta 3001 é publicada. 127.0.0.1 = só o proxy local alcança.
APP_BIND=127.0.0.1
# Token do scrape de /api/metrics (Prometheus). Vazio = endpoint desligado.
METRICS_TOKEN=
# Workers que pensam a jogada do Monstro. Vazio = núcleos - 1 (de 1 a 4).
BOT_WORKERS=
# Backup fora da máquina (infra/backup.sh): destino do rclone e, opcional, quem pode abrir (GPG).
BACKUP_REMOTE=
BACKUP_GPG_RECIPIENT=
