# Porta HTTP/Socket.IO
PORT=3001
# Postgres do infra/docker-compose.yml (docker compose -f infra/docker-compose.yml up -d)
DATABASE_URL=postgresql://domino:domino@localhost:5442/domino
# Obrigatório em produção (NODE_ENV=production). Em dev usa um segredo padrão com aviso.
JWT_SECRET=troca-por-um-segredo-comprido
# Origens liberadas no CORS, separadas por vírgula. Vazio = qualquer localhost.
CORS_ORIGIN=
# Push (web-push). Gere com: pnpm --filter @domino/server vapid. Sem chaves, push fica desligado.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@dominomanezinho.app
# Proxy reverso confiável para ler o IP real: vazio/false, nº de saltos (ex.: 1) ou lista de IPs/CIDRs.
TRUST_PROXY=
# Limite de requisições por IP (false desliga; não desligue em produção).
RATE_LIMIT=true
# Hosts aceitos como endpoint de push, separados por vírgula. Vazio = serviços conhecidos (FCM, Mozilla, Windows, Apple).
PUSH_HOSTS=
# Pasta do arquivo de estado: mesas em andamento e resultados pendentes sobrevivem a reinício. Vazio = reiniciar fecha as mesas.
STATE_DIR=.state
# Carência (ms) para os jogadores reconectarem depois de restaurar as mesas.
RESTORE_GRACE_MS=60000
# Pasta do build do web (apps/web/dist) para servir o app junto, com fallback SPA. Opcional.
WEB_DIST=
# Token do scrape de /api/metrics (Prometheus, "Authorization: Bearer <token>"). Vazio = sem métricas.
METRICS_TOKEN=
# Workers que pensam a jogada do Monstro fora do event loop. Vazio = núcleos - 1 (de 1 a 4); 0 = no processo principal.
BOT_WORKERS=
# Tempos (ms). BOT_DELAY_MS aceita faixa "min-max".
BOT_DELAY_MS=900-1600
QUICK_FILL_MS=20000
DISCONNECT_GRACE_MS=10000
NEXT_HAND_MS=5000
ROOM_ABANDON_MS=120000
